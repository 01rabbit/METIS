+    std::atomic<uint64_t> memory_update_retry_attempts{0};
+    std::atomic<uint64_t> memory_update_retry_successes{0};
+    std::atomic<uint64_t> memory_update_retry_false_results{0};
+};
+
+struct metis_trace_state {
+    std::array<char, 33> nonce{};
+    std::atomic<bool> requests_started{false};
+    std::atomic<bool> inject_retry_once{false};
+    metis_trace_counts startup;
+    metis_trace_counts requests;
+
+    metis_trace_state() {
+        const char * value = std::getenv("METIS_LLAMA_TRACE_NONCE");
+        if (value == nullptr || std::strlen(value) != nonce.size() - 1) {
+            return;
+        }
+        for (size_t i = 0; i < nonce.size() - 1; ++i) {
+            if (!((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f'))) {
+                return;
+            }
+        }
+        std::memcpy(nonce.data(), value, nonce.size());
+        const char * inject = std::getenv("METIS_LLAMA_TRACE_INJECT_RETRY_ONCE");
+        inject_retry_once.store(inject != nullptr && std::strcmp(inject, "1") == 0);
+    }
+
+    bool enabled() const { return nonce[0] != '\0'; }
+
+    metis_trace_counts & active() {
+        return requests_started.load(std::memory_order_relaxed) ? requests : startup;
+    }
+
+    ~metis_trace_state() {
+        if (!enabled()) {
+            return;
+        }
+        auto emit = [](const char * name, const metis_trace_counts & counts) {
+            std::fprintf(stderr,
+                "\"%s\":{\"process_calls\":%llu,\"process_encode_calls\":%llu,"
+                "\"process_decode_calls\":%llu,\"process_failures\":%llu,"
+                "\"input_positions\":%llu,\"encode_calls\":%llu,\"decode_calls\":%llu,"
+                "\"graph_dispatches\":%llu,\"graph_positions\":%llu,"
+                "\"graph_failures\":%llu,\"graph_pre_dispatch_failures\":%llu,"
+                "\"zero_position_graphs\":%llu,\"server_batch_retries\":%llu,"
+                "\"injected_memory_prepare_failures\":%llu,\"memory_prepare_failures\":%llu,"
+                "\"memory_update_retry_attempts\":%llu,\"memory_update_retry_successes\":%llu,"
+                "\"memory_update_retry_false_results\":%llu}",
+                name,
+                static_cast<unsigned long long>(counts.process_calls.load()),
+                static_cast<unsigned long long>(counts.process_encode_calls.load()),
+                static_cast<unsigned long long>(counts.process_decode_calls.load()),
+                static_cast<unsigned long long>(counts.process_failures.load()),
+                static_cast<unsigned long long>(counts.input_positions.load()),
+                static_cast<unsigned long long>(counts.encode_calls.load()),
+                static_cast<unsigned long long>(counts.decode_calls.load()),
+                static_cast<unsigned long long>(counts.graph_dispatches.load()),
+                static_cast<unsigned long long>(counts.graph_positions.load()),
+                static_cast<unsigned long long>(counts.graph_failures.load()),
+                static_cast<unsigned long long>(counts.graph_pre_dispatch_failures.load()),
+                static_cast<unsigned long long>(counts.zero_position_graphs.load()),
+                static_cast<unsigned long long>(counts.server_batch_retries.load()),
+                static_cast<unsigned long long>(counts.injected_memory_prepare_failures.load()),
+                static_cast<unsigned long long>(counts.memory_prepare_failures.load()),
+                static_cast<unsigned long long>(counts.memory_update_retry_attempts.load()),
+                static_cast<unsigned long long>(counts.memory_update_retry_successes.load()),
+                static_cast<unsigned long long>(counts.memory_update_retry_false_results.load()));
+        };
+        std::fputs("METIS_LLAMA_TRACE_V1 {\"version\":1,\"source_commit\":"
+                   "\"b1b770d90d94cad9e9ea5b993bdbc383a522fb28\",\"nonce\":\"",
+                   stderr);
+        std::fputs(nonce.data(), stderr);
+        std::fputs("\",", stderr);
+        emit("startup", startup);
+        std::fputc(',', stderr);
+        emit("requests", requests);
+        std::fputs("}\n", stderr);
+        std::fflush(stderr);
+    }
+};
+
+static metis_trace_state metis_trace;
+
+static void metis_trace_process_start(llama_process_type type, uint64_t n_tokens) {
+    if (!metis_trace.enabled()) return;
+    auto & counts = metis_trace.active();
+    counts.process_calls.fetch_add(1, std::memory_order_relaxed);
+    counts.input_positions.fetch_add(n_tokens, std::memory_order_relaxed);
+    if (type == LLAMA_PROCESS_TYPE_ENCODE) {
+        counts.process_encode_calls.fetch_add(1, std::memory_order_relaxed);
+    } else if (type == LLAMA_PROCESS_TYPE_DECODE) {
+        counts.process_decode_calls.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+static void metis_trace_process_finish(int32_t status) {
+    if (metis_trace.enabled() && status != 0) {
+        metis_trace.active().process_failures.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+static void metis_trace_graph_start(uint32_t n_tokens) {
+    if (!metis_trace.enabled()) return;
+    auto & counts = metis_trace.active();
+    counts.graph_dispatches.fetch_add(1, std::memory_order_relaxed);
+    counts.graph_positions.fetch_add(n_tokens, std::memory_order_relaxed);
+    if (n_tokens == 0) counts.zero_position_graphs.fetch_add(1, std::memory_order_relaxed);
+}
+
+static void metis_trace_graph_finish(ggml_status status) {
+    if (metis_trace.enabled() && status != GGML_STATUS_SUCCESS) {
+        metis_trace.active().graph_failures.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+static void metis_trace_pre_dispatch_failure() {
+    if (metis_trace.enabled()) {
+        metis_trace.active().graph_pre_dispatch_failures.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+static bool metis_trace_take_retry_injection() {
+    if (!metis_trace.enabled() || !metis_trace.requests_started.load(std::memory_order_relaxed)) {
+        return false;
+    }
+    bool expected = true;
+    return metis_trace.inject_retry_once.compare_exchange_strong(expected, false);
+}
+} // namespace
+
+void llama_metis_trace_mark_ready(void) {
+    if (metis_trace.enabled()) {
+        metis_trace.requests_started.store(true, std::memory_order_relaxed);
+    }
+}
+
+void llama_metis_trace_server_batch_retry(void) {
+    if (metis_trace.enabled()) {
+        metis_trace.active().server_batch_retries.fetch_add(1, std::memory_order_relaxed);
+    }
+}
