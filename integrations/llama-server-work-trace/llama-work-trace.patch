+    std::atomic<uint64_t> process_decode_calls{0};
+    std::atomic<uint64_t> process_failures{0};
+    std::atomic<uint64_t> input_positions{0};
+    std::atomic<uint64_t> encode_calls{0};
+    std::atomic<uint64_t> decode_calls{0};
+    std::atomic<uint64_t> graph_dispatches{0};
