@@ -4 +16,53 @@ int main(int argc, char ** argv) {
-    return llama_server(argc, argv);
+    if (argc != 7 || std::string_view(argv[1]) != "--metis-work-budget"
+            || std::string_view(argv[3]) != "--model" || std::string_view(argv[5]) != "--port") {
+        std::fputs("Usage: llama-server --metis-work-budget TOKENS --model LOCAL_GGUF --port PORT\n", stderr);
+        return 2;
+    }
+
+    for (auto entry = environ; *entry != nullptr; ++entry) {
+        const std::string_view variable(*entry);
+        if (variable.substr(0, 6) == "LLAMA_" || variable.substr(0, 5) == "GGML_"
+                || variable.substr(0, 4) == "AIP_") {
+            std::fputs("METIS inference and server environment overrides are disabled\n", stderr);
+            return 2;
+        }
+    }
+
+    const std::string_view budget_arg(argv[2]);
+    uint64_t budget = 0;
+    const auto end = budget_arg.data() + budget_arg.size();
+    const auto parsed = std::from_chars(budget_arg.data(), end, budget);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || !llama_metis_set_work_budget(budget)) {
+        std::fputs("Invalid METIS work budget\n", stderr);
+        return 2;
+    }
+
+    std::error_code model_error;
+    if (!std::filesystem::is_regular_file(argv[4], model_error)) {
+        std::fputs("METIS requires a regular local model file\n", stderr);
+        return 2;
+    }
+
+    const std::string_view port_arg(argv[6]);
+    uint32_t port = 0;
+    const auto port_end = port_arg.data() + port_arg.size();
+    const auto port_parsed = std::from_chars(port_arg.data(), port_end, port);
+    if (port_parsed.ec != std::errc{} || port_parsed.ptr != port_end || port == 0 || port > 65535) {
+        std::fputs("Invalid METIS server port\n", stderr);
+        return 2;
+    }
+
+    // The upstream parser accepts mutable argv and consumes one value after each
+    // option. Model and port are the only forwarded caller-provided values.
+    std::vector<std::string> strict_args{
+        argv[0], "--model", argv[4], "--port", argv[6], "--host", "127.0.0.1",
+        "--parallel", "1", "--ctx-size", "4096", "--gpu-layers", "0", "--fit", "off",
+        "--no-warmup", "--no-context-shift", "--no-ui", "--offline",
+        "--spec-type", "none", "--no-mmproj", "--cors-origins", "localhost",
+    };
+    std::vector<char *> strict_argv;
+    for (auto & arg : strict_args) {
+        strict_argv.push_back(arg.data());
+    }
+    strict_argv.push_back(nullptr);
+    return llama_server(static_cast<int>(strict_args.size()), strict_argv.data());
