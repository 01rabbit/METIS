diff --git a/src/metis-work-budget.h b/src/metis-work-budget.h
new file mode 100644
index 000000000..abf4a83dc
--- /dev/null
+++ b/src/metis-work-budget.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+class metis_work_budget {
+public:
+    bool initialize(uint64_t tokens) {
+        if (tokens == 0 || tokens == uninitialized) {
+            return false;
+        }
+        auto expected = uninitialized;
+        return remaining.compare_exchange_strong(expected, tokens, std::memory_order_relaxed);
+    }
+
+    bool reserve(uint32_t tokens) {
+        if (tokens == 0) {
+            return false;
+        }
+        auto available = remaining.load(std::memory_order_relaxed);
+        while (available != uninitialized && available >= tokens) {
+            if (remaining.compare_exchange_weak(available, available - tokens, std::memory_order_relaxed)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+private:
+    static constexpr auto uninitialized = std::numeric_limits<uint64_t>::max();
+    std::atomic<uint64_t> remaining{uninitialized};
+};
