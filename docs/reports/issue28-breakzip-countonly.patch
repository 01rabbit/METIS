+class CompactBucketTable {
+  public:
+    static constexpr uint32_t NONE = 0xffffffffu;
+    CompactBucketTable() : heads(0x01000000, NONE) {}
+    void add(uint32_t key, const stage1a &value) {
+        const uint32_t index = static_cast<uint32_t>(values.size());
+        values.push_back(value);
+        next.push_back(heads[key]);
+        heads[key] = index;
+    }
+    uint32_t head(uint32_t key) const { return heads[key]; }
+    uint32_t next_index(uint32_t index) const { return next[index]; }
+    const stage1a &value(uint32_t index) const { return values[index]; }
+    size_t entries_size() const { return values.size(); }
+  private:
+    std::vector<uint32_t> heads;
+    std::vector<stage1a> values;
+    std::vector<uint32_t> next;
+};
