+static bool metis_private_socket(const std::filesystem::path & socket_path) {
+    const auto & literal = socket_path.native();
+    const auto is_control = [](unsigned char c) { return c < 32 || c == 127; };
+    if (!socket_path.is_absolute() || socket_path.extension() != ".sock"
+            || literal.size() >= sizeof(sockaddr_un{}.sun_path)
+            || std::any_of(literal.begin(), literal.end(), is_control)) {
+        return false;
+    }
+    const auto parent = socket_path.parent_path();
+    std::error_code error;
+    if (std::filesystem::canonical(parent, error) != parent || error) {
+        return false;
+    }
+    struct stat parent_stat{};
+    if (lstat(parent.c_str(), &parent_stat) != 0 || !S_ISDIR(parent_stat.st_mode)
+            || parent_stat.st_uid != geteuid() || (parent_stat.st_mode & 07777) != 0700) {
+        return false;
+    }
+    struct stat socket_stat{};
+    return lstat(socket_path.c_str(), &socket_stat) == -1 && errno == ENOENT;
+}
+
+static bool metis_prepare_receipt_pipe(int fd) {
+    struct stat receipt_stat{};
+    if (fd < 3 || fstat(fd, &receipt_stat) != 0 || !S_ISFIFO(receipt_stat.st_mode)) {
+        return false;
+    }
+    const int status = fcntl(fd, F_GETFL);
+    const int descriptor = fcntl(fd, F_GETFD);
+    return status >= 0 && descriptor >= 0 && (status & O_ACCMODE) == O_WRONLY
+        && fcntl(fd, F_SETFL, status | O_NONBLOCK) == 0
+        && fcntl(fd, F_SETFD, descriptor | FD_CLOEXEC) == 0;
+}
+
