+static metis_work_budget work_budget;
+static uint64_t work_cap = 0;
+static int work_receipt_fd = -1;
+static std::array<char, 33> work_nonce{};
+static std::mutex work_finish_mutex;
+static bool work_finished = false;
+
+bool llama_metis_set_work_budget(uint64_t tokens, int receipt_fd, const char * nonce) {
+    if (receipt_fd < 3 || nonce == nullptr || std::strlen(nonce) != work_nonce.size() - 1
+            || std::strspn(nonce, "0123456789abcdef") != work_nonce.size() - 1
+            || !work_budget.initialize(tokens)) {
+        return false;
+    }
+    work_cap = tokens;
+    work_receipt_fd = receipt_fd;
+    std::memcpy(work_nonce.data(), nonce, work_nonce.size());
+    return true;
+}
+
+static void metis_report_work(const char * reason) {
+    const std::lock_guard<std::mutex> lock(work_finish_mutex);
+    if (work_finished) {
+        return;
+    }
+    const uint64_t remaining = work_budget.seal();
+    if (work_receipt_fd < 0 || remaining > work_cap) {
+        std::_Exit(74);
+    }
+    std::array<char, 256> message{};
+    const int length = std::snprintf(message.data(), message.size(),
+        "{\"version\":1,\"nonce\":\"%s\",\"cap\":%" PRIu64
+        ",\"charged\":%" PRIu64 ",\"reason\":\"%s\"}\n",
+        work_nonce.data(), work_cap, work_cap - remaining, reason);
+    if (length <= 0 || static_cast<size_t>(length) >= message.size()) {
+        std::_Exit(74);
+    }
+
+    // The launcher accepts only a nonblocking pipe. This single record is
+    // smaller than PIPE_BUF, so the pipe accepts it atomically or fails.
+    ssize_t written;
+    do {
+        written = write(work_receipt_fd, message.data(), static_cast<size_t>(length));
+    } while (written < 0 && errno == EINTR);
+    if (written != length) {
+        std::_Exit(74);
+    }
+    close(work_receipt_fd);
+    work_receipt_fd = -1;
+    work_finished = true;
+}
+
+int llama_metis_finish_work_budget(int server_status) {
+    metis_report_work(server_status == 0 ? "shutdown" : "server_error");
+    return server_status;
+}
+
+void llama_metis_abort_unmetered_work(void) {
+    metis_report_work("unsupported_graph");
+    std::_Exit(75);
+}
